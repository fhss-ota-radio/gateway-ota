<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>OtaManager</class>
 <widget class="QMainWindow" name="OtaManager">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1024</width>
    <height>600</height>
   </rect>
  </property>
  <!-- 2026-08-20: 세로형(760x780)에서 가로형(1024x600, 7인치 LCD 기준)으로
       재배치. 세로일 땐 카드 5개를 위→아래로 쌓기만 해도 됐지만, 가로에서
       그대로 쌓으면 카드마다 높이를 나눠 가지느라 각 카드가 답답해짐 —
       그래서 좌/우 2열로 바꿈: 왼쪽엔 "보내기 전 설정하는 것들"(연결·전송
       대상·파일), 오른쪽엔 "보내는 동안 보는 것들"(진행률·로그). 실제
       사용 흐름과도 맞음 — 왼쪽에서 설정 끝내고 오른쪽을 보면서 기다리는
       식. rootLayout의 stretch(0,1)로 왼쪽은 내용물 크기만큼만, 오른쪽은
       남는 공간을 전부 가져가게 함(로그가 넓어야 쓸모 있어서). -->
  <property name="windowTitle">
   <string>OTA Manager</string>
  </property>
  <widget class="QWidget" name="centralwidget">
   <layout class="QHBoxLayout" name="rootLayout" stretch="0,1">
    <property name="leftMargin"><number>16</number></property>
    <property name="topMargin"><number>16</number></property>
    <property name="rightMargin"><number>16</number></property>
    <property name="bottomMargin"><number>16</number></property>
    <property name="spacing"><number>12</number></property>
    <item>
     <layout class="QVBoxLayout" name="leftColumnLayout">
      <property name="spacing"><number>12</number></property>
      <item>
       <widget class="QGroupBox" name="connectionGroup">
        <property name="title"><string>연결 (Transport)</string></property>
        <layout class="QVBoxLayout" name="connectionOuterLayout">
         <item>
          <layout class="QFormLayout" name="connectionFormLayout">
           <item row="0" column="0">
            <widget class="QLabel" name="driverLabel">
             <property name="text"><string>드라이버 선택</string></property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QComboBox" name="driverCombo">
             <item><property name="text"><string>로컬 파일 (테스트용)</string></property></item>
             <item><property name="text"><string>CC1101 (/dev/cc1101)</string></property></item>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="portLabel">
             <property name="text"><string>디바이스 경로 / 포트</string></property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QLineEdit" name="portEdit">
             <property name="placeholderText"><string>/dev/cc1101</string></property>
            </widget>
           </item>
          </layout>
         </item>
         <item>
          <layout class="QHBoxLayout" name="connectButtonLayout">
           <item>
            <widget class="QPushButton" name="connectButton">
             <property name="text"><string>연결</string></property>
            </widget>
           </item>
           <item>
            <spacer name="connectButtonSpacer">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
             <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
            </spacer>
           </item>
          </layout>
         </item>
         <item>
          <layout class="QHBoxLayout" name="statusLayout">
           <item>
            <widget class="QLabel" name="connectionStatusDot">
             <property name="minimumSize"><size><width>10</width><height>10</height></size></property>
             <property name="maximumSize"><size><width>10</width><height>10</height></size></property>
             <property name="styleSheet"><string notr="true">background-color:#c0392b; border-radius:5px;</string></property>
             <property name="text"><string/></property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="connectionStatusLabel">
             <property name="text"><string>연결 안 됨</string></property>
            </widget>
           </item>
           <item>
            <spacer name="statusSpacer">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
             <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
            </spacer>
           </item>
          </layout>
         </item>
        </layout>
       </widget>
      </item>
      <item>
       <widget class="QGroupBox" name="targetGroup">
        <property name="title"><string>전송 대상</string></property>
        <layout class="QVBoxLayout" name="targetOuterLayout">
         <item>
          <layout class="QHBoxLayout" name="modeLayout">
           <item>
            <widget class="QRadioButton" name="unicastRadio">
             <property name="text"><string>유니캐스트</string></property>
             <property name="checked"><bool>true</bool></property>
             <attribute name="buttonGroup"><string notr="true">modeButtonGroup</string></attribute>
            </widget>
           </item>
           <item>
            <widget class="QRadioButton" name="broadcastRadio">
             <property name="text"><string>브로드캐스트</string></property>
             <attribute name="buttonGroup"><string notr="true">modeButtonGroup</string></attribute>
            </widget>
           </item>
           <item>
            <spacer name="modeSpacer">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
             <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
            </spacer>
           </item>
          </layout>
         </item>
         <item>
          <layout class="QFormLayout" name="targetFormLayout">
           <item row="0" column="0">
            <widget class="QLabel" name="targetLabel">
             <property name="text"><string>대상 ESP32 (무전기 노드)</string></property>
            </widget>
           </item>
           <item row="0" column="1">
            <layout class="QHBoxLayout" name="targetRowLayout">
             <item>
              <widget class="QComboBox" name="targetCombo">
               <!-- 2026-08-23: 자리표시자 "Node 01/02/03" 대신 비워둠 —
                    discoverDevices() 결과로만 채워지고, 각 항목의 실제
                    device_id(uint32_t)는 item data(Qt::UserRole)에 저장됨
                    (표시 텍스트는 사람이 읽는 hex 문자열이라 파싱하지 않기
                    위함). otamanager.cpp의 handleDiscoveredDevices() 참고. -->
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="discoverButton">
               <property name="text"><string>기기 조회 (DISCOVER)</string></property>
              </widget>
             </item>
            </layout>
           </item>
          </layout>
         </item>
        </layout>
       </widget>
      </item>
      <item>
       <widget class="QGroupBox" name="fhssGroup">
        <!-- 2026-08-23 추가 (Task #4), 2026-08-24 개편: 수동 시드 입력 +
             별도 "FHSS 활성화" 버튼 방식(FHSS 호핑(실험적))을 없애고, secret_seed
             txt 파일 드롭다운 선택 + "전송 시작" 클릭 시 자동 시드 파생/활성화로
             바꿈 — otamanager.cpp의 onStartClicked()가
             core/hopseed.h(deriveSessionHopSeed())로 public_seed를 매번 새로
             만들어 hop_seed를 파생하고, 그 값을 그대로 기존
             rolloutFhssConfig()(CONFIG/ACTIVATE 핸드셰이크) +
             Cc1101Transport::configureFhss()/startFhss()(Gateway 자신의 커널
             호핑 시작)에 넘긴다. "FHSS 중지"만 수동 중단용으로 남겨둠. 여러
             기기 동시 호핑은 아직 지원 안 함(session/fhssrollout.h 설계상
             기기 하나씩만 처리 — ACK에 발신 기기 구분 필드가 없어서, 대상
             여러 개를 한 번에 보내면 어느 응답이 누구 것인지 알 수 없기
             때문). 자세한 설계 이유는 docs/note/design-notes-gateway-ota-es.md
             45절 참고. -->
        <property name="title"><string>FHSS 호핑</string></property>
        <layout class="QVBoxLayout" name="fhssOuterLayout">
         <item>
          <layout class="QFormLayout" name="fhssFormLayout">
           <item row="0" column="0">
            <widget class="QLabel" name="secretSeedFolderLabel">
             <property name="text"><string>시드 폴더</string></property>
            </widget>
           </item>
           <item row="0" column="1">
            <layout class="QHBoxLayout" name="secretSeedFolderLayout">
             <item>
              <widget class="QLineEdit" name="secretSeedFolderEdit">
               <property name="readOnly"><bool>true</bool></property>
              </widget>
             </item>
             <item>
              <widget class="QPushButton" name="secretSeedFolderBrowseButton">
               <property name="text"><string>폴더 선택</string></property>
              </widget>
             </item>
            </layout>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="secretSeedVersionLabel">
             <property name="text"><string>펌웨어 버전 (secret_seed)</string></property>
            </widget>
           </item>
           <item row="1" column="1">
            <layout class="QHBoxLayout" name="secretSeedVersionLayout">
             <item>
              <widget class="QComboBox" name="secretSeedVersionCombo"/>
             </item>
             <item>
              <widget class="QPushButton" name="secretSeedRefreshButton">
               <property name="text"><string>새로고침</string></property>
              </widget>
             </item>
            </layout>
           </item>
           <item row="2" column="0">
            <widget class="QLabel" name="fhssChannelCountLabel">
             <property name="text"><string>채널 수</string></property>
            </widget>
           </item>
           <item row="2" column="1">
            <widget class="QSpinBox" name="fhssChannelCountSpin">
             <property name="minimum"><number>1</number></property>
             <property name="maximum"><number>32</number></property>
             <property name="value"><number>8</number></property>
            </widget>
           </item>
           <item row="3" column="0">
            <widget class="QLabel" name="fhssFirstChannelLabel">
             <property name="text"><string>시작 채널 (랑데부 채널과 동일)</string></property>
            </widget>
           </item>
           <item row="3" column="1">
            <widget class="QSpinBox" name="fhssFirstChannelSpin">
             <!-- 채널 0은 OTA 전용(reservedChannel)이라 호핑 범위에서 제외 —
                  fhssrollout.h의 FhssHopPolicy::reservedChannel 주석 참고 -->
             <property name="minimum"><number>1</number></property>
             <property name="maximum"><number>255</number></property>
             <property name="value"><number>1</number></property>
            </widget>
           </item>
           <item row="4" column="0">
            <widget class="QLabel" name="fhssGenerationLabel">
             <property name="text"><string>Generation</string></property>
            </widget>
           </item>
           <item row="4" column="1">
            <widget class="QSpinBox" name="fhssGenerationSpin">
             <!-- 오래된/재전송된 설정을 걸러내기 위한 버전 번호 — 활성화
                  성공할 때마다 otamanager.cpp가 자동으로 1씩 올려줌 -->
             <property name="minimum"><number>0</number></property>
             <property name="maximum"><number>2147483647</number></property>
             <property name="value"><number>1</number></property>
            </widget>
           </item>
          </layout>
         </item>
         <item>
          <widget class="QLabel" name="fhssHintLabel">
           <property name="text"><string>※ 유니캐스트 모드에서 "기기 조회"로 대상을 먼저 고르세요. 시드 폴더에서 펌웨어 버전을 선택한 뒤 "전송 시작"을 누르면 새 public_seed 생성 → HMAC-SHA256 세션 시드 파생 → FHSS 활성화 → 전송이 한 번에 진행됩니다(브로드캐스트는 호핑 없이 그대로 전송). 이 대상 하나와만 호핑을 맺습니다(여러 기기 동시 호핑은 아직 미지원).</string></property>
           <property name="styleSheet"><string notr="true">color:#7f8c8d; font-size:11px;</string></property>
           <property name="wordWrap"><bool>true</bool></property>
          </widget>
         </item>
         <item>
          <layout class="QHBoxLayout" name="fhssButtonLayout">
           <item>
            <widget class="QPushButton" name="fhssStopButton">
             <property name="enabled"><bool>false</bool></property>
             <property name="text"><string>FHSS 중지</string></property>
            </widget>
           </item>
           <item>
            <spacer name="fhssButtonSpacer">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
             <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
            </spacer>
           </item>
          </layout>
         </item>
         <item>
          <widget class="QLabel" name="fhssStatusLabel">
           <property name="text"><string>비활성</string></property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>
      <item>
       <widget class="QGroupBox" name="fileGroup">
        <property name="title"><string>펌웨어 BIN 파일</string></property>
        <layout class="QVBoxLayout" name="fileOuterLayout">
         <item>
          <layout class="QHBoxLayout" name="fileRowLayout">
           <item>
            <widget class="QPushButton" name="selectFileButton">
             <property name="text"><string>파일 선택</string></property>
            </widget>
           </item>
           <item>
            <widget class="QLabel" name="filePathLabel">
             <property name="text"><string>선택된 파일 없음</string></property>
            </widget>
           </item>
          </layout>
         </item>
         <item>
          <layout class="QGridLayout" name="fileInfoGridLayout">
           <item row="0" column="0">
            <widget class="QLabel" name="fileSizeTitleLabel">
             <property name="text"><string>파일 크기</string></property>
            </widget>
           </item>
           <item row="1" column="0">
            <widget class="QLabel" name="fileSizeValueLabel">
             <property name="text"><string>-</string></property>
            </widget>
           </item>
           <item row="0" column="1">
            <widget class="QLabel" name="chunkSizeTitleLabel">
             <property name="text"><string>청크 크기 (byte)</string></property>
            </widget>
           </item>
           <item row="1" column="1">
            <widget class="QLabel" name="chunkSizeValueLabel">
             <!-- OTA_MAX_PAYLOAD_SIZE(ota_protocol.h)로 고정된 값 — 무선 패킷
                  본문 최대 크기에서 정해지는 것이라 사용자가 바꿀 수 있는 값이
                  아님. 예전엔 QSpinBox였는데, OtaSession이 이 값을 항상
                  OTA_MAX_PAYLOAD_SIZE로 고정해서 쓰기 시작한 뒤로는(파라미터로
                  안 받음) 입력칸이 있어도 실제 전송에 반영 안 되는 죽은 UI가
                  되어 QLabel로 교체함. 실제 텍스트는 otamanager.cpp
                  recalcChunkInfo()에서 OTA_MAX_PAYLOAD_SIZE로 채움 -->
             <property name="text"><string>48 (고정)</string></property>
            </widget>
           </item>
           <item row="0" column="2">
            <widget class="QLabel" name="totalChunksTitleLabel">
             <property name="text"><string>총 청크 수</string></property>
            </widget>
           </item>
           <item row="1" column="2">
            <widget class="QLabel" name="totalChunksValueLabel">
             <property name="text"><string>-</string></property>
            </widget>
           </item>
          </layout>
         </item>
        </layout>
       </widget>
      </item>
      <item>
       <spacer name="leftColumnBottomSpacer">
        <property name="orientation"><enum>Qt::Vertical</enum></property>
        <property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property>
       </spacer>
      </item>
     </layout>
    </item>
    <item>
     <layout class="QVBoxLayout" name="rightColumnLayout" stretch="0,1">
      <property name="spacing"><number>12</number></property>
      <item>
       <widget class="QGroupBox" name="progressGroup">
        <property name="title"><string>전송 진행률</string></property>
        <layout class="QVBoxLayout" name="progressOuterLayout">
         <item>
          <widget class="QProgressBar" name="progressBar">
           <property name="value"><number>0</number></property>
          </widget>
         </item>
         <item>
          <layout class="QHBoxLayout" name="progressInfoLayout">
           <item>
            <widget class="QLabel" name="progressStatusLabel">
             <property name="text"><string>대기 중</string></property>
            </widget>
           </item>
           <item>
            <spacer name="progressInfoSpacer">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
             <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
            </spacer>
           </item>
           <item>
            <widget class="QLabel" name="ackStatusLabel">
             <property name="text"><string>ACK 0 / 0 · 재전송 0회</string></property>
            </widget>
           </item>
          </layout>
         </item>
         <item>
          <layout class="QHBoxLayout" name="progressButtonLayout">
           <item>
            <spacer name="progressButtonSpacer">
             <property name="orientation"><enum>Qt::Horizontal</enum></property>
             <property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property>
            </spacer>
           </item>
           <item>
            <widget class="QPushButton" name="startButton">
             <property name="text"><string>전송 시작</string></property>
            </widget>
           </item>
           <item>
            <widget class="QPushButton" name="pauseButton">
             <property name="enabled"><bool>false</bool></property>
             <property name="text"><string>일시정지</string></property>
            </widget>
           </item>
          </layout>
         </item>
        </layout>
       </widget>
      </item>
      <item>
       <widget class="QGroupBox" name="logGroup">
        <property name="title"><string>로그</string></property>
        <layout class="QVBoxLayout" name="logOuterLayout">
         <item>
          <widget class="QPlainTextEdit" name="logView">
           <property name="font">
            <font>
             <family>Courier New</family>
             <pointsize>10</pointsize>
            </font>
           </property>
           <property name="readOnly"><bool>true</bool></property>
           <property name="maximumBlockCount"><number>2000</number></property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>
     </layout>
    </item>
   </layout>
  </widget>
  <widget class="QMenuBar" name="menubar">
   <property name="geometry">
    <rect>
     <x>0</x>
     <y>0</y>
     <width>1024</width>
     <height>33</height>
    </rect>
   </property>
  </widget>
  <widget class="QStatusBar" name="statusbar"/>
 </widget>
 <resources/>
 <connections/>
 <buttongroups>
  <buttongroup name="modeButtonGroup"/>
 </buttongroups>
</ui>
